<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".areaPix">

<!--    Area pix -->
    <TextView
        android:layout_width="206dp"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:textSize="25sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="20dp"
        android:text="Área Pix"
        />
<!--Texto abaixo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="20dp"
        android:text="Envie e receba pagamentos a qualquer hora e dia da semana, sem pagar nada por isso "
        android:textColor="#808080"
        android:textSize="20sp" />

<!--    Linear dos primerios botoes-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="124dp"
        android:layout_gravity="center">
        <!-- Linear do botao Transferir-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_gravity="center">

            <!--        Botao transferir-->
            <Button
                android:id="@+id/btnTransferir"
                android:layout_width="65sp"
                android:layout_height="75sp"
                android:layout_margin="10dp"
                android:backgroundTint="#D3D3D3"
                app:cornerRadius="100dp"
                app:icon="@drawable/transferir"
                app:iconTint="#000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transferir"
                android:layout_gravity="center"

                />
        </LinearLayout>
        <!-- Linear od botão Programar-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_gravity="center">
            <!--        Botao Programar-->
            <Button
                android:layout_width="65sp"
                android:layout_height="75sp"
                android:layout_margin="10dp"
                android:backgroundTint="#D3D3D3"
                app:cornerRadius="100dp"
                app:icon="@drawable/programar2"
                app:iconTint="#000000"

                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Programar"
                android:layout_gravity="center"

                />
        </LinearLayout>
        <!-- Linear do btn Ler qr code-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_gravity="center"
            >
        <!--        Botao ler qr code-->
            <Button
                android:layout_width="65sp"
                android:layout_height="75sp"
                android:layout_margin="10dp"
                android:backgroundTint="#D3D3D3"
                app:cornerRadius="100dp"
                app:icon="@drawable/qrcode"
                app:iconTint="#000000"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ler Qr Code"
                android:layout_gravity="center"
                />
        </LinearLayout>
    </LinearLayout>


<!--Linear da segunda fileira de botoes-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        >
        <!-- Botao pix copia-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            >
            <Button
                android:layout_width="65sp"
                android:layout_height="75sp"
                app:icon="@drawable/pix"
                android:layout_margin="10dp"
                app:cornerRadius="100dp"
                app:iconTint="#000000"
                android:backgroundTint="#D3D3D3"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pix copia"
                android:layout_gravity="center"

                />
        </LinearLayout>

        <!--Botao cobrar-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            >
        <Button
            android:layout_width="65sp"
            android:layout_height="75sp"
            app:icon="@drawable/cobrar"
            android:layout_margin="10dp"
            app:cornerRadius="100dp"
            app:iconTint="#000000"
            android:backgroundTint="#D3D3D3"

            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cobrar"
            android:layout_gravity="center"

            />
        </LinearLayout>

        <!--Botao depositar-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            >

        <Button
            android:layout_width="65sp"
            android:layout_height="75sp"
            app:icon="@drawable/depositar"
            android:layout_margin="10dp"
            app:cornerRadius="100dp"
            app:iconTint="#000000"
            android:backgroundTint="#D3D3D3"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Depositar"
            android:layout_gravity="center"

        />
        </LinearLayout>

    </LinearLayout>



    <TextView
        android:layout_width="357dp"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:layout_marginTop="40dp"
        android:layout_marginLeft="20dp"
        android:text="Preferências"
        android:textColor="#808080"
        android:textSize="20sp" />

    <TextView
        android:layout_width="328dp"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:layout_marginLeft="35dp"
        android:layout_marginTop="20dp"
        android:text="Registrar ou trazer chaves"
        android:textSize="20sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="328dp"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:layout_marginLeft="35dp"
        android:layout_marginTop="20dp"
        android:text="Configurar Pix"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>